# POD Email Agent settings
#
# How to use this file:
#   1. Copy it to .env:            Copy-Item .env.example .env
#   2. Replace every <...> with your own value.
#   3. Check what is still missing: python -m app.check_setup
#
# How to write a setting:
#   - One setting per line: NAME=value, with no quotes.
#   - Notes go on their own line, starting with #. Text after a value on the
#     same line becomes part of the value.
#   - Separate the items of a list with ";".
#   - Required: the agent stops at start until you fill it in.
#     Optional: leave it empty if you do not need it.
#     Set by the dashboard: change it in the dashboard, not here.
#
# .env stays on your PC; git never commits it. docs/ARCHITECTURE.md
# section 6 describes every setting in more detail.


# === 1. Mailbox ===============================================================

# Required. The mailbox name at the top of Outlook's folder list.
# Example: POD
POD_OUTLOOK_MAILBOX=<mailbox name>

# Required. The shared mailbox's email address. Replies go out from it.
# Example: pod@example.com
POD_SHARED_MAILBOX_ADDRESS=<shared mailbox address>


# === 2. Folders and files =====================================================

# Required. The SharePoint folder synced to this PC. The training workbook
# and the files for Power Automate live here.
# Example: C:\Users\you\Example Company\POD-data
POD_SHAREPOINT_DATA_DIR=<synced SharePoint folder>

# Required. The training workbook's file name, inside that folder.
# Example: training_data.xlsx
POD_TRAINING_DATA_FILE=<training data file>

# Optional. The folder for the Power Automate files. Leave the line as a
# note to use the "handoff" folder inside POD_SHAREPOINT_DATA_DIR.
# Example: C:\Users\you\Example Company\POD-data\handoff
# POD_HANDOFF_DIR=<folder>

# Required. The folders with the signed PDF scans, one per year.
# Example: \\server\share\POD\2025;\\server\share\POD\2026
POD_SCAN_FOLDERS=<scan folder>;<scan folder>

# Optional. Folder names to skip inside the scan folders.
# Example: Archive;Unverified
POD_SCAN_EXCLUDED_FOLDERS=

# Optional. A list of known numbers that labels the historical pull for you:
# an .xlsx or .csv file with the columns DoNumber and Reference.
# Example: data\master_numbers.csv
POD_MASTER_NUMBER_DATA=


# === 3. Reading the numbers ===================================================

# Optional. Letters a connote can start with, tried in this order. With AB
# set, the agent reads AB-10234 and AB10234 as connotes. Empty: the agent
# reads only connotes of 6 to 10 digits.
# Example: AB;XY
POD_CONNOTE_PREFIXES=

# Optional. Customers whose scans sit in their own subfolder, written as
# email domain=subfolder. The subfolder sits inside each scan folder.
# Example: example3.com=Example3
#   The agent then looks for example3.com's scans in
#   \\server\share\POD\2026\Example3. A match found anywhere else goes to
#   the team first.
POD_SENDER_FOLDERS=

# Optional. Senders the historical pull labels as not a POD request,
# separated by ",".
# Example: noreply@example5.com,billing@example6.com
POD_SKIPPED_SENDER_EMAILS=


# === 4. Replies ===============================================================

# Set by the dashboard (Settings tab, Automatic replies).
#   draft:   every reply waits in Drafts for the team to send.
#   partial: replies to the domains below go out; the rest stay drafts.
#   send:    every reply goes out.
POD_SEND_MODE=draft
# Set by the dashboard. The domains for partial mode, the part after the @.
# Example: example1.com;example2.com
POD_SEND_DOMAINS=

# Required. The largest total attachment size, in MB. A bigger reply becomes
# a draft without its files, and the team attaches them by hand.
# Example: 20
POD_MAX_ATTACHMENT_MB=20

# Optional. Where those files are copied for the team, and the same folder's
# address on SharePoint. The folder must sync to SharePoint and sit outside
# the project and the scan folders. Empty: no copies.
# Example: C:\Users\you\Example Company\POD-manual
# Example: https://example.sharepoint.com/sites/pod/Shared Documents/POD-manual
POD_MANUAL_UPLOAD_DIR=
POD_MANUAL_UPLOAD_URL=

# Optional. The signature for replies, as an HTML file. Keep it in data\,
# which git ignores. Empty: a plain "Kind Regards, POD Teams".
# Example: data\signature.html
POD_SIGNATURE_FILE=


# === 5. Finished emails =======================================================

# Optional. The folder, right under the mailbox, where fully answered emails
# go once the dashboard switch is on. Empty: Actioned/Finished.
# Example: Actioned/Finished
POD_FINISHED_FOLDER=

# Set by the dashboard (Settings tab, Move finished emails): on or off, and
# the time it was switched on.
POD_MOVE_FINISHED=off
POD_MOVE_FINISHED_SINCE=


# === 6. Power BI ==============================================================
# Write table and column names exactly as Power BI shows them.

# Required. The main table, and its connote and reference columns.
# Example: TMS, Con Note, Reference
POD_PBI_TABLE=TMS
POD_PBI_CONNOTE_COLUMN=<connote column>
POD_PBI_REFERENCE_COLUMN=<reference column>

# Required. How each other table joins the main table:
# OtherTable[key]=MainTable[key].
# Example: POD Scans[Con Note]=TMS[Con Note]
POD_PBI_LINKS=POD Scans[<key column>]=TMS[<key column>]

# Required. The columns to bring back, as Name=Table[Column]. You choose each
# Name; the settings below and the Outstanding list refer to it.
# Example: Sender=TMS[Sender Name];POD Status=TMS[Status]
POD_PBI_COLUMNS=Sender=TMS[<sender column>];Receiver=TMS[<receiver column>];Date In TMS=TMS[<date column>];POD Status=TMS[<POD status column>];Scan Path=POD Scans[<scan path column>]

# Required. The Name that holds the POD status.
# Example: POD Status
POD_PBI_STATUS_COLUMN=POD Status

# Optional. The Name that holds the path of a row's scan. When it names a
# PDF on the share, the agent sends that exact file. Empty: not used.
# Example: Scan Path
POD_PBI_SCAN_PATH_COLUMN=Scan Path

# Optional. Customers whose Power BI rows count only when the sender column
# holds a word, written as email domain=word.
# Example: example3.com=example3
POD_PBI_SENDER_CHECK=
# The Name that holds the sender.
# Example: Sender
POD_PBI_SENDER_COLUMN=Sender

# Optional. A second table, for consignments missing from the main table.
# Its columns use the Names from POD_PBI_COLUMNS, as Name=Column. Empty all
# four lines if there is no second table.
# Example: Receiver=Receiver Name;POD Status=Status
POD_PBI_SECOND_TABLE=DeliveryApp
POD_PBI_SECOND_CONNOTE_COLUMN=<connote column>
POD_PBI_SECOND_REFERENCE_COLUMN=
POD_PBI_SECOND_COLUMNS=Receiver=DeliveryApp[<receiver column>];Date In TMS=DeliveryApp[<date column>];POD Status=DeliveryApp[<POD status column>]


# === 7. POD Outstanding list ==================================================

# Required before replies. What goes in each Excel column, as
# Excel column=source. A source is one of: number, connote, reference,
# pod_status, sender_email, subject, received_time, requested_at, or
# pbi:Name for a column from POD_PBI_COLUMNS. Columns you leave out stay
# empty for the team.
# Example: CONSIGNMENT=connote;CUSTOMER EMAIL=sender_email;SENDER=pbi:Sender
POD_OUTSTANDING_COLUMNS=EMAIL DATE=received_time;CUSTOMER EMAIL=sender_email;CONSIGNMENT=connote;PO REF=reference;SENDER=pbi:Sender;RECEIVER=pbi:Receiver;DATE IN TMS=pbi:Date In TMS;POD_STATUS=pod_status


# === 8. Models ================================================================

# Set by the dashboard. How sure the intent model must be before the agent
# acts without a person, from 0.5 to below 1.
# Example: 0.95
POD_CONFIDENCE_THRESHOLD=0.95

# How sure the number model must be that a token is a number, from 0 to 1.
# Example: 0.5
POD_NUMBER_CONFIDENCE_THRESHOLD=0.5

# Set by the dashboard. The targets the dashboard compares the figures with:
# the share of drafts sent with the same PODs, and the intent model's
# precision. They change nothing in how the agent works.
# Example: 0.90
POD_PILOT_TARGET=0.90
POD_PRECISION_TARGET=0.90

# The labeled emails each class needs before the agent trusts the intent
# model. Fewer: every email with a number goes to a person.
# Example: 150
POD_MIN_TRAINING_SAMPLES_PER_CLASS=150

# The most emails one historical pull exports.
# Example: 2000
POD_HISTORICAL_EMAIL_LIMIT=2000


# === 9. Dashboard =============================================================

# Set by the dashboard. Auto-refresh on or off, and how often, in seconds
# (10 to 3600).
# Example: 30
POD_DASHBOARD_AUTO_REFRESH=on
POD_DASHBOARD_REFRESH_INTERVAL_SECONDS=30
